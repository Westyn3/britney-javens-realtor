---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>North Atlanta Real Estate Blog — Britney Javens</title>
  <subtitle>Market updates, buying and selling guidance, and community guides for Alpharetta, Milton, Roswell, Norcross and North Atlanta.</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ '/' | absolute_url }}</id>
  <author>
    <name>Britney Javens</name>
    <uri>{{ '/' | absolute_url }}</uri>
  </author>
{% for post in site.posts %}  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html" />
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <id>{{ post.url | absolute_url }}</id>
    <author><name>Britney Javens</name></author>
{% if post.city %}    <category term="{{ post.city | xml_escape }}" />
{% endif %}    <summary type="text">{{ post.description | xml_escape }}</summary>
  </entry>
{% endfor %}</feed>
